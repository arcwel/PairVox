              "surface": "Package.swift and Package.resolved",
              "recorded_by": "Dependency SCA Specialist",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/network-pairing-wire-protocol-security",
          "ruleIndex": 2,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Network Pairing & Wire Protocol Security — No issue identified: PairVoxLink & PairVoxLinkKit\n\nAudited LinkHost.swift, TCPTransport.swift, LinkCrypto.swift, HandshakeWire.swift, PairingWire.swift, and DeviceKeyStore.swift. Verified ChaCha20-Poly1305 frame encryption with strict sequence counters, HMAC-SHA256 constant-time handshake proofs, HKDF key derivation, and process UID verification via getpeereid on control sockets."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "PairVoxLink & PairVoxLinkKit"
                }
              ]
            }
